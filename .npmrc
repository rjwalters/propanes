# pnpm 10+'s "self-management" (auto-switching to the exact version pinned by
# packageManager) generates an internal bin shim that is deliberately
# shebang-less (see pnpm/pnpm#16594) so a shell or glibc's execvp can retry it
# under /bin/sh once the kernel answers ENOEXEC for a direct exec. Turborepo's
# task runner execs that path directly and has no such retry, so every
# `turbo <task>` fails with "Exec format error" the moment a packageManager
# pin is set. We already pin + enforce the exact pnpm version through
# `corepack prepare pnpm@<version> --activate` in both Dockerfiles, so turn
# self-management off and let it (and turbo) resolve plain `pnpm` off PATH.
manage-package-manager-versions=false
